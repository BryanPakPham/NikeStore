
@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container-fluid bg-img py-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card border-0 shadow p-4 p-md-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold mb-2">NIKE.</h2>
                    <h4 class="fw-bold">CREATE ACCOUNT</h4>
                    <p class="text-muted mb-0">Join Nike and enjoy your shopping</p>
                </div>
                <form method="post" action="@Url.Action("Register", "Account")">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label ms-3 fw-semibold">Full Name</label>
                        <input type="text" style="margin-left:30px" name="full_name" class="form-control w-100 py-2 " placeholder="Enter your full name" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label ms-3 fw-semibold">Email</label>
                        <input type="email" style="margin-left:30px" name="email" class="form-control w-100 py-2" placeholder="Enter your email" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label ms-3 fw-semibold">Password</label>
                        <input type="password" style="margin-left:30px" name="password" class="form-control w-100 py-2" placeholder="Create a password" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label ms-3 fw-semibold">Phone</label>
                        <input type="tel" style="margin-left:30px" name="phone" class="form-control w-100 py-2" placeholder="Enter your phone number" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label ms-3 fw-semibold">Address</label>
                        <textarea name="address" style="margin-left:30px" class="form-control w-100" rows="3" placeholder="Enter your address" required></textarea>
                    </div>

                    <button type="submit" class="btn btn-dark w-100 py-2 fw-bold">
                        CREATE ACCOUNT
                    </button>
                </form>

                <div class="text-center mt-4">
                    <span class="text-muted">Already have an account?</span>
                    <a href="@Url.Action("Login", "Account")" class="text-dark fw-bold text-decoration-none">Sign In</a>
                </div>
            </div>
        </div>
    </div>
</div>
