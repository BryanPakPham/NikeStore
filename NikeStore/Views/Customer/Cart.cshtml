
@model IEnumerable<NikeStore.Models.product_variants>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Shopping Cart";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    var gioHang = ViewBag.GioHang as Dictionary<int, int> ?? new Dictionary<int, int>();
    var danhSachMau = ViewBag.DanhSachMau as IEnumerable<NikeStore.Models.product_colors> ?? new List<NikeStore.Models.product_colors>();
    var danhSachAnh = ViewBag.DanhSachAnh as IEnumerable<NikeStore.Models.product_images> ?? new List<NikeStore.Models.product_images>();
    decimal tongTien = 0;
    if (Model != null)
    {
        foreach (var item in Model)
        {
            int soLuong = gioHang.ContainsKey(item.variant_id) ? gioHang[item.variant_id] : 0;
            tongTien += item.product.price * soLuong;
        }
    }
}
<div class="container py-5">
    <h2 class="fw-bold mb-4">SHOPPING CART</h2>
    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <h4>Your cart is empty</h4>
            <p class="text-muted">Discover your favorite Nike shoes.</p>
            <a href="@Url.Content("~/Customer/Product/Index")" class="btn btn-dark mt-3">SHOP NOW</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- DANH SÁCH SẢN PHẨM -->
            <div class="col-lg-8">
                @foreach (var item in Model)
                {
                    int soLuong = gioHang.ContainsKey(item.variant_id) ? gioHang[item.variant_id] : 0;
                    var mau = danhSachMau.FirstOrDefault(m => m.product_color_id == item.product_color_id);
                    var anh = danhSachAnh.FirstOrDefault(a => a.product_color_id == item.product_color_id);
                    decimal thanhTien = item.product.price * soLuong;
                    <div class="card mb-3">
                        <div class="row g-0">
                            <div class="col-4">
                                @if (anh != null)
                                {
                                    <img src="@Url.Content(anh.image_url)" class="img-fluid rounded-start h-100 w-100" style="object-fit:contain;background:#f5f5f5;" alt="@item.product.product_name" />
                                }
                            </div>
                            <div class="col-8">
                                <div class="card-body">
                                    <h5 class="card-title fw-bold">@item.product.product_name</h5>
                                    <p class="text-muted mb-1">Color: @(mau != null && mau.color != null ? mau.color.color_name : "N/A")</p>
                                    <p class="text-muted mb-1">Size: @item.size.size_value</p>
                                    <p class="mb-1">Price: @String.Format("{0:N0}₫", item.product.price)</p>
                                    <p class="mb-1">Quantity: @soLuong</p>
                                    <h6 class="fw-bold mt-2">Subtotal: @String.Format("{0:N0}₫", thanhTien)</h6>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <!-- TỔNG TIỀN -->
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">ORDER SUMMARY</h5>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Products</span>
                            <span>@gioHang.Values.Sum()</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between">
                            <h5 class="fw-bold">TOTAL</h5>
                            <h5 class="fw-bold">@String.Format("{0:N0}₫", tongTien)</h5>
                        </div>
                        <a href="@Url.Action("Index", "Checkout")" class="btn btn-dark w-100 mt-3">
                            CHECK OUT
                        </a>
                        <a href="@Url.Content("~/Customer/Product/Index")" class="btn btn-outline-dark w-100 mt-3">CONTINUE SHOPPING</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
