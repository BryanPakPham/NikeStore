@model IEnumerable<NikeStore.Models.product>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Collection";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    var danhSachAnh = ViewBag.DanhSachAnh as IEnumerable<NikeStore.Models.product_images> ?? new List<NikeStore.Models.product_images>();
}
<section class="customer-products container-fluid px-4 px-lg-5 py-5">
    <div class="customer-products-heading">
        <p class="products-breadcrumb">NIKE / COLLECTIONS</p>
        <h1>@ViewBag.CollectionName</h1>
        <p>Explore the collection.</p>
    </div>
    <div class="products-toolbar">
        <span>@Model.Count() Products</span>
    </div>
    <div class="row g-4">
        @foreach (var item in Model)
        {
            var anhSanPham = danhSachAnh.FirstOrDefault(i => i.product_id == item.product_id);
            <div class="col-6 col-md-4 col-lg-3">
                <div class="customer-product-card">
                    <div class="customer-product-image-wrap">
                        @if (anhSanPham != null)
                        {
                            <img src="@Url.Content(anhSanPham.image_url)" alt="@item.product_name" class="customer-product-image" />
                        }
                        else
                        {
                            <div class="customer-product-no-image">IMAGE NOT AVAILABLE</div>
                        }
                    </div>
                    <div class="customer-product-info">
                        <h5>@item.product_name</h5>
                        <p>Nike Shoes</p>
                        <strong>@String.Format("{0:N0}₫", item.price)</strong>
                    </div>
                </div>
            </div>
        }
    </div>
</section>