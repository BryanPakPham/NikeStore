@model IEnumerable<NikeStore.Models.product_variants>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Checkout";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    var gioHang = ViewBag.GioHang as Dictionary<int, int> ?? new Dictionary<int, int>();
    var danhSachMau = ViewBag.DanhSachMau as IEnumerable<NikeStore.Models.product_colors> ?? new List<NikeStore.Models.product_colors>();
    var danhSachAnh = ViewBag.DanhSachAnh as IEnumerable<NikeStore.Models.product_images> ?? new List<NikeStore.Models.product_images>();
}
<div class="container py-5">
    <h2 class="fw-bold mb-4">CHECKOUT</h2>
    <div class="row g-4">
        <!-- THÔNG TIN GIAO HÀNG -->
        <div class="col-lg-7">
            <div class="card">
                <div class="card-body">
                    <h5 class="fw-bold mb-4">DELIVERY INFORMATION</h5>
                    <form method="post" action="@Url.Action("PlaceOrder", "Order")">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <input type="text" name="recipientName" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Phone Number</label>
                            <input type="tel" name="recipientPhone" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Shipping Address</label>
                            <textarea name="shippingAddress" class="form-control" rows="3" required></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Note</label>
                            <textarea name="note" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Payment Method</label>
                            <select name="paymentMethod" class="form-select">
                                <option value="COD">Cash on Delivery (COD)</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-dark w-100 py-3">PLACE ORDER</button>
                    </form>
                </div>
            </div>
        </div>
        <!-- YOUR ORDER -->
        <div class="col-lg-5">
            <div class="card">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">YOUR ORDER</h5>
                    @foreach (var item in Model)
                    {
                        int soLuong = gioHang[item.variant_id];
                        var mau = danhSachMau.FirstOrDefault(m => m.product_color_id == item.product_color_id);
                        var anh = danhSachAnh.FirstOrDefault(a => a.product_color_id == item.product_color_id);
                        <div class="row g-3 mb-3 align-items-center">
                            <div class="col-auto">
                                @if (anh != null)
                                {
                                    <img src="@Url.Content(anh.image_url)" class="rounded" style="width:90px;height:90px;object-fit:contain;background:#f5f5f5;" alt="@item.product.product_name" />
                                }
                            </div>
                            <div class="col">
                                <h6 class="fw-bold">@item.product.product_name</h6>
                                <p class="text-muted small mb-1">Color: @(mau != null && mau.color != null ? mau.color.color_name : "")</p>
                                <p class="text-muted small mb-1">Size: @item.size.size_value</p>
                                <div class="d-flex justify-content-between">
                                    <span>Quantity: @soLuong</span>
                                    <strong>@String.Format("{0:N0}₫", item.product.price * soLuong)</strong>
                                </div>
                            </div>
                        </div>
                        <hr />
                    }
                    <div class="d-flex justify-content-between mb-2">
                        <span>Shipping fee</span>
                        <span>Free</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <h5 class="fw-bold">TOTAL</h5>
                        <h5 class="fw-bold">@String.Format("{0:N0}₫", ViewBag.TongTien)</h5>
                    </div>
                    <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-dark w-100 mt-3">BACK TO CART</a>
                </div>
            </div>
        </div>
    </div>
</div>