
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container-fluid bg-img py-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card border-0 shadow p-4 p-md-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold mb-2">NIKE.</h2>
                    <h4 class="fw-bold">WELCOME BACK</h4>
                    <p class="text-muted mb-0">Sign in to your Nike account</p>
                </div>
                <form method="post" action="@Url.Action("Login", "Account")">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label ms-4 fw-semibold">Email</label> <br />
                        <input type="email" name="email" style="margin-left:70px" class="form-control" placeholder="Enter your email" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label ms-4 fw-semibold">Password</label>
                        <input type="password" style="margin-left:70px" name="password" class="form-control w-100 py-2" placeholder="Enter your password" required />
                    </div>

                    <button type="submit" class="btn btn-dark w-50 py-2 fw-bold" style="margin-left:100px">
                        SIGN IN
                    </button>
                </form>

                <div class="text-center mt-4">
                    <span class="text-muted">Don't have an account?</span>
                    <a href="@Url.Action("Register", "Account")" class="text-dark fw-bold text-decoration-none">Sign Up</a>
                </div>
            </div>
        </div>
    </div>
</div>
