@{
    string active = ViewBag.ActiveNav as string ?? "";
    string employeeName = ViewBag.EmployeeName as string ?? "Nhân viên";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Nike Nhân viên</title>

    <!-- Bootstrap 5: bản trong project (nếu có) + CDN. Thiếu cái nào thì cái còn lại vẫn chạy -->
    <link rel="stylesheet" href="@Url.Content("~/Content/bootstrap.css")" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        /* =====================================================================
           EMPLOYEE (STAFF) AREA
           Cùng ngôn ngữ thiết kế với trang chủ Nike Store:
           đen / trắng / xám, chữ in hoa đậm, góc vuông (rounded-0), Arial.
           CSS nằm ngay trong layout nên không cần thêm file .css nào.
           ===================================================================== */

        :root {
            --staff-black: #000000;
            --staff-ink: #111111;
            --staff-muted: #777777;
            --staff-soft: #999999;
            --staff-line: #e5e5e5;
            --staff-bg: #f5f5f5;
        }

        body.staff-body {
            background-color: var(--staff-bg);
            color: var(--staff-ink);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* site.css giới hạn input rộng 280px, bỏ giới hạn đó trong khu vực staff */
        .staff-body input,
        .staff-body select,
        .staff-body textarea {
            max-width: none;
        }

        .staff-main {
            flex: 1 0 auto;
        }

        .staff-container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 clamp(16px, 4vw, 48px);
        }

        /* ---------- NAVBAR (giống thanh điều hướng trang chủ) ---------- */
        .staff-navbar {
            background-color: #000000;
            min-height: 85px;
            padding: 15px 0;
        }

            .staff-navbar .navbar-collapse {
                flex-grow: 1;
            }

        .nike-logo {
            color: #ffffff !important;
            font-size: 32px;
            font-weight: 900;
            letter-spacing: -2px;
            text-decoration: none;
        }

            .nike-logo span {
                color: #999999;
            }

        .staff-brand {
            display: flex;
            align-items: center;
        }

        .staff-tag {
            margin-left: 14px;
            padding: 3px 9px;
            border: 1px solid #555555;
            color: var(--staff-soft);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
        }

        .staff-nav-links {
            gap: 25px;
        }

        .staff-account-links {
            gap: 15px;
            align-items: center;
        }

        .staff-navbar .nav-link {
            color: #ffffff !important;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 1px;
            padding-bottom: 6px;
            border-bottom: 2px solid transparent;
            transition: color 0.3s ease;
        }

            .staff-navbar .nav-link:hover {
                color: #999999 !important;
            }

            .staff-navbar .nav-link.active {
                border-bottom-color: #ffffff;
            }

        .staff-navbar .navbar-toggler {
            border-color: #ffffff;
        }

        .staff-navbar .navbar-toggler-icon {
            filter: invert(1);
        }

        .staff-user {
            color: var(--staff-soft);
            font-size: 12px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        /* ---------- PAYMENT PILL ---------- */
        .pay-pill {
            display: inline-block;
            margin-top: 4px;
            padding: 2px 8px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .pay-unpaid {
            background: #fff4d6;
            color: #8a5a00;
        }

        .pay-paid {
            background: #dcfce7;
            color: #166534;
        }

        .pay-failed {
            background: #fdecea;
            color: #b91c1c;
        }

        .pay-refunded {
            background: #ede9fe;
            color: #5b21b6;
        }

        /* ---------- ITEM THUMBNAIL ---------- */
        .item-cell {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .item-thumb {
            width: 64px;
            height: 64px;
            flex: 0 0 auto;
            background: #f5f5f5;
            object-fit: contain;
        }

        .item-thumb-empty {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #bbbbbb;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        /* ---------- FLASH MESSAGE ---------- */
        .staff-alert {
            border-radius: 0;
            border: 0;
            border-left: 4px solid var(--staff-black);
            font-size: 14px;
            font-weight: 600;
            margin: 24px 0 0;
        }

        .staff-alert-success {
            background: #e8f5e9;
            color: #14532d;
            border-left-color: #16a34a;
        }

        .staff-alert-error {
            background: #fdecea;
            color: #7f1d1d;
            border-left-color: #dc2626;
        }

        /* ---------- HERO (dashboard) - giống banner trang chủ ---------- */
        .staff-hero {
            background: linear-gradient(120deg, #000000 0%, #171717 60%, #2b2b2b 100%);
            color: #ffffff;
            padding: clamp(32px, 5vw, 56px) clamp(20px, 5vw, 64px);
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 24px;
            flex-wrap: wrap;
        }

        .staff-eyebrow {
            letter-spacing: 4px;
            font-weight: 600;
            font-size: 12px;
            color: var(--staff-soft);
            margin: 0 0 10px;
            text-transform: uppercase;
        }

        .staff-hero h1 {
            font-size: clamp(34px, 6vw, 72px);
            font-weight: 900;
            line-height: 1;
            letter-spacing: -2px;
            margin: 0 0 14px;
            color: #ffffff;
        }

        .staff-hero-sub {
            color: #cccccc;
            margin: 0;
            max-width: 520px;
        }

        /* ---------- PAGE HEAD (trang con) ---------- */
        .staff-page-head {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
            padding: 36px 0 24px;
        }

            .staff-page-head .staff-eyebrow {
                color: var(--staff-muted);
                letter-spacing: 3px;
                margin-bottom: 6px;
            }

            .staff-page-head h1 {
                font-size: clamp(28px, 4vw, 40px);
                font-weight: 900;
                letter-spacing: -1px;
                margin: 0;
                text-transform: uppercase;
            }

            .staff-page-head p.staff-sub {
                color: var(--staff-muted);
                margin: 6px 0 0;
            }

        .staff-back {
            color: var(--staff-muted);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-decoration: none;
            text-transform: uppercase;
        }

            .staff-back:hover {
                color: var(--staff-black);
            }

        /* ---------- SECTION HEADING (giống .home-section-heading) ---------- */
        .staff-section {
            margin-top: 40px;
        }

        .staff-section-title {
            font-size: 22px;
            font-weight: 800;
            margin: 0 0 4px;
            text-transform: uppercase;
        }

        .staff-section-sub {
            color: var(--staff-muted);
            margin: 0 0 18px;
            font-size: 14px;
        }

        /* ---------- CARD ---------- */
        .staff-card {
            background: #ffffff;
            border: 1px solid var(--staff-line);
            border-radius: 0;
        }

        .staff-card-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 18px 24px;
            border-bottom: 1px solid var(--staff-line);
        }

        .staff-card-title {
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin: 0;
        }

        .staff-card-body {
            padding: 24px;
        }

        /* ---------- STAT CARDS ---------- */
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
            gap: 16px;
            margin-top: 28px;
        }

        .stat-card {
            display: block;
            background: #ffffff;
            border: 1px solid var(--staff-line);
            border-bottom: 4px solid transparent;
            padding: 22px 22px 18px;
            color: var(--staff-ink);
            text-decoration: none;
            transition: border-color 0.2s ease, transform 0.2s ease;
        }

            .stat-card:hover {
                color: var(--staff-ink);
                border-bottom-color: var(--staff-black);
                transform: translateY(-2px);
            }

        .stat-label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            color: var(--staff-muted);
            text-transform: uppercase;
        }

        .stat-value {
            display: block;
            font-size: 46px;
            font-weight: 900;
            line-height: 1.1;
            letter-spacing: -2px;
            margin-top: 8px;
        }

        .stat-hint {
            display: block;
            font-size: 12px;
            color: var(--staff-soft);
            margin-top: 2px;
        }

        /* ô cần chú ý: đảo màu đen/trắng như banner */
        .stat-card.is-alert {
            background: var(--staff-black);
            border-color: var(--staff-black);
            color: #ffffff;
        }

            .stat-card.is-alert:hover {
                color: #ffffff;
                border-bottom-color: #ffffff;
            }

            .stat-card.is-alert .stat-label,
            .stat-card.is-alert .stat-hint {
                color: #bbbbbb;
            }

        /* ---------- TABLE ---------- */
        .staff-table {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
        }

            .staff-table th {
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 1.5px;
                text-transform: uppercase;
                color: var(--staff-muted);
                padding: 14px 16px;
                border-bottom: 2px solid var(--staff-ink);
                white-space: nowrap;
                background: #ffffff;
            }

            .staff-table td {
                padding: 16px;
                border-bottom: 1px solid #eeeeee;
                vertical-align: middle;
                font-size: 14px;
            }

            .staff-table tbody tr:hover {
                background: #fafafa;
            }

            .staff-table .num {
                text-align: right;
                white-space: nowrap;
            }

            .staff-table .actions {
                text-align: right;
                white-space: nowrap;
            }

        .cell-main {
            font-weight: 800;
            color: var(--staff-ink);
            text-decoration: none;
        }

        a.cell-main:hover {
            text-decoration: underline;
        }

        .cell-sub {
            display: block;
            font-size: 12px;
            color: var(--staff-muted);
            margin-top: 2px;
        }

        /* ---------- STATUS PILL ---------- */
        .status-pill {
            display: inline-block;
            padding: 5px 11px;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .status-pending {
            background: #fff4d6;
            color: #8a5a00;
        }

        .status-confirmed {
            background: #e3edff;
            color: #1d4ed8;
        }

        .status-shipping {
            background: #ede9fe;
            color: #5b21b6;
        }

        .status-completed {
            background: #dcfce7;
            color: #166534;
        }

        .status-cancelled {
            background: #eeeeee;
            color: #6b6b6b;
            text-decoration: line-through;
        }

        .status-pill[class*="status-"]:not(.status-pending):not(.status-confirmed):not(.status-shipping):not(.status-completed):not(.status-cancelled) {
            background: #eeeeee;
            color: #333333;
        }

        /* ---------- BUTTONS ---------- */
        .staff-body .btn {
            border-radius: 0;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 12px;
            font-weight: 700;
            padding: 10px 22px;
        }

        .staff-body .btn-sm {
            padding: 7px 14px;
            font-size: 11px;
        }

        .staff-body .btn-dark {
            background: var(--staff-black);
            border-color: var(--staff-black);
        }

            .staff-body .btn-dark:hover {
                background: #333333;
                border-color: #333333;
            }

        .staff-body .btn-outline-dark:hover {
            background: var(--staff-black);
            color: #ffffff;
        }

        /* ---------- FORM ---------- */
        .staff-label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #555555;
            margin-bottom: 6px;
        }

        .staff-body .form-control,
        .staff-body .form-select {
            border-radius: 0;
            border: 1px solid #cfcfcf;
            padding: 11px 14px;
            font-size: 14px;
        }

            .staff-body .form-control:focus,
            .staff-body .form-select:focus {
                border-color: var(--staff-black);
                box-shadow: none;
            }

            .staff-body .form-control[readonly] {
                background: #f1f1f1;
                color: #666666;
            }

        .staff-search {
            display: flex;
            gap: 8px;
            min-width: min(100%, 420px);
        }

        /* ---------- STATUS TABS ---------- */
        .status-tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 4px 28px;
            border-bottom: 1px solid var(--staff-line);
            margin-bottom: 24px;
        }

            .status-tabs a {
                padding: 12px 0;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 1.5px;
                text-transform: uppercase;
                color: var(--staff-muted);
                text-decoration: none;
                border-bottom: 3px solid transparent;
                margin-bottom: -1px;
            }

                .status-tabs a:hover {
                    color: var(--staff-black);
                }

                .status-tabs a.active {
                    color: var(--staff-black);
                    border-bottom-color: var(--staff-black);
                }

            .status-tabs .tab-count {
                display: inline-block;
                min-width: 22px;
                padding: 1px 6px;
                margin-left: 6px;
                background: #e9e9e9;
                color: #333333;
                font-size: 11px;
                text-align: center;
            }

            .status-tabs a.active .tab-count {
                background: var(--staff-black);
                color: #ffffff;
            }

        /* ---------- ORDER TRACKER ---------- */
        .order-tracker {
            display: flex;
            align-items: flex-start;
            padding: 28px 24px;
        }

        .tracker-step {
            flex: 1;
            text-align: center;
            position: relative;
        }

            .tracker-step::before {
                content: "";
                position: absolute;
                top: 15px;
                left: -50%;
                width: 100%;
                height: 2px;
                background: #dddddd;
                z-index: 0;
            }

            .tracker-step:first-child::before {
                display: none;
            }

            .tracker-step.done::before,
            .tracker-step.current::before {
                background: var(--staff-black);
            }

        .tracker-dot {
            position: relative;
            z-index: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #ffffff;
            border: 2px solid #dddddd;
            color: #aaaaaa;
            font-size: 12px;
            font-weight: 800;
        }

        .tracker-step.done .tracker-dot {
            background: var(--staff-black);
            border-color: var(--staff-black);
            color: #ffffff;
        }

        .tracker-step.current .tracker-dot {
            background: #ffffff;
            border-color: var(--staff-black);
            color: var(--staff-black);
            box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.1);
        }

        .tracker-label {
            display: block;
            margin-top: 10px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #aaaaaa;
        }

        .tracker-step.done .tracker-label,
        .tracker-step.current .tracker-label {
            color: var(--staff-black);
        }

        .cancelled-banner {
            background: #eeeeee;
            border-left: 4px solid #6b6b6b;
            padding: 18px 24px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            font-size: 13px;
        }

        /* ---------- INFO LIST ---------- */
        .info-row {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            padding: 12px 0;
            border-bottom: 1px solid #f0f0f0;
            font-size: 14px;
        }

            .info-row:last-child {
                border-bottom: 0;
            }

        .info-label {
            flex: 0 0 auto;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--staff-muted);
            padding-top: 2px;
        }

        .info-value {
            text-align: right;
            word-break: break-word;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            font-size: 14px;
            color: #555555;
        }

            .total-row.grand {
                border-top: 2px solid var(--staff-ink);
                margin-top: 8px;
                padding-top: 14px;
                font-size: 18px;
                font-weight: 900;
                color: var(--staff-ink);
            }

        /* ---------- AVATAR ---------- */
        .avatar {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: var(--staff-black);
            color: #ffffff;
            font-weight: 800;
            font-size: 16px;
            flex: 0 0 auto;
        }

            .avatar.lg {
                width: 72px;
                height: 72px;
                font-size: 28px;
            }

        .person-cell {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        /* ---------- LOW STOCK LIST ---------- */
        .stock-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 14px 24px;
            border-bottom: 1px solid #f0f0f0;
        }

            .stock-item:last-child {
                border-bottom: 0;
            }

        .stock-badge {
            min-width: 44px;
            padding: 6px 10px;
            text-align: center;
            font-weight: 900;
            font-size: 15px;
            background: #fff4d6;
            color: #8a5a00;
        }

            .stock-badge.out {
                background: #fdecea;
                color: #b91c1c;
            }

        /* ---------- PAGINATION ---------- */
        .staff-pagination {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 6px;
            margin: 28px 0 0;
        }

            .staff-pagination a,
            .staff-pagination span {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 40px;
                height: 40px;
                padding: 0 12px;
                border: 1px solid #d5d5d5;
                background: #ffffff;
                color: var(--staff-ink);
                font-size: 13px;
                font-weight: 700;
                text-decoration: none;
            }

                .staff-pagination a:hover {
                    border-color: var(--staff-black);
                }

            .staff-pagination .current {
                background: var(--staff-black);
                border-color: var(--staff-black);
                color: #ffffff;
            }

            .staff-pagination .disabled {
                color: #bbbbbb;
                background: #fafafa;
            }

        /* ---------- EMPTY STATE ---------- */
        .staff-empty {
            text-align: center;
            padding: 56px 20px;
            color: var(--staff-muted);
        }

            .staff-empty strong {
                display: block;
                font-size: 18px;
                font-weight: 900;
                color: var(--staff-ink);
                text-transform: uppercase;
                margin-bottom: 6px;
            }

        /* ---------- FOOTER ---------- */
        .staff-footer {
            flex-shrink: 0;
            background: #000000;
            margin-top: 56px;
            padding: 22px 12px;
            text-align: center;
        }

            .staff-footer p {
                margin: 0;
                color: #777777;
                font-size: 11px;
                letter-spacing: 1px;
            }

        /* ---------- RESPONSIVE ---------- */
        @@media (max-width: 991.98px) {
            .staff-navbar .nav-link.active {
                border-bottom-color: transparent;
            }

            .staff-user {
                margin-top: 10px;
            }
        }

        @@media (max-width: 768px) {
            .order-tracker {
                padding: 20px 8px;
            }

            .tracker-label {
                font-size: 9.5px;
                letter-spacing: 0.5px;
            }

            .stat-value {
                font-size: 38px;
            }

            .staff-search {
                min-width: 100%;
            }
        }
    </style>
</head>
<body class="staff-body">

    <!-- NAVBAR (cùng phong cách với trang chủ) -->
    <nav class="navbar navbar-expand-lg staff-navbar">
        <div class="container-fluid px-4 px-lg-5">
            <div class="staff-brand">
                <a class="navbar-brand nike-logo me-0" href="@Url.Content("~/Employee/Dashboard")">NIKE<span>.</span></a>
                <span class="staff-tag">NHÂN VIÊN</span>
            </div>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#staffNavbar" aria-controls="staffNavbar" aria-expanded="false" aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="staffNavbar">
                <ul class="navbar-nav mx-auto staff-nav-links">
                    <li class="nav-item">
                        <a class="nav-link @(active == "dashboard" ? "active" : "")" href="@Url.Content("~/Employee/Dashboard")">TỔNG QUAN</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(active == "orders" ? "active" : "")" href="@Url.Content("~/Employee/Order")">ĐƠN HÀNG</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(active == "customers" ? "active" : "")" href="@Url.Content("~/Employee/Customer")">KHÁCH HÀNG</a>
                    </li>
                </ul>
                <ul class="navbar-nav staff-account-links">
                    <li class="nav-item staff-user">@employeeName</li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Content("~/")">XEM CỬA HÀNG</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Content("~/Customer/Account/Logout")">ĐĂNG XUẤT</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- THÔNG BÁO -->
    @if (TempData["Success"] != null || TempData["Error"] != null)
    {
        <div class="staff-container">
            @if (TempData["Success"] != null)
            {
                <div class="alert staff-alert staff-alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert staff-alert staff-alert-error alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
        </div>
    }

    <!-- NỘI DUNG -->
    <main class="staff-main">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="staff-footer">
        <p>© @DateTime.Now.Year NIKE STORE. CỔNG NHÂN VIÊN.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        if (!window.bootstrap) {
            document.write('<script src="@Url.Content("~/Scripts/bootstrap.bundle.min.js")"><\/script>');
        }
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
