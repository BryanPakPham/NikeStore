@model NikeStore.Models.category
@{ ViewBag.Title = "Chỉnh sửa danh mục"; }
<h1 class="h3 mb-3">Chỉnh sửa danh mục</h1>
@using (Html.BeginForm("CategoryEdit", "Category", FormMethod.Post, new { @class = "col-lg-7" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.category_id)
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    <div class="mb-3">
        @Html.LabelFor(m => m.category_name, "Tên danh mục", new { @class = "form-label" })
        @Html.TextBoxFor(m => m.category_name, new { @class = "form-control", maxlength = "100", required = "required" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.slug, "Slug (đường dẫn)", new { @class = "form-label" })
        @Html.TextBoxFor(m => m.slug, new { @class = "form-control", maxlength = "120", required = "required" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.description, "Mô tả", new { @class = "form-label" })
        @Html.TextAreaFor(m => m.description, new { @class = "form-control", rows = "3", maxlength = "500" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.display_order, "Thứ tự hiển thị", new { @class = "form-label" })
        @Html.TextBoxFor(m => m.display_order, new { @class = "form-control", type = "number", step = "1" })
    </div>
    <div class="form-check mb-3">
        @Html.CheckBox("is_active", Model.is_active == true, new { @class = "form-check-input" })
        <label class="form-check-label" for="is_active">Đang hoạt động</label>
    </div>
    <button class="btn btn-dark" type="submit">Lưu thay đổi</button>
    @Html.ActionLink("Quay lại", "Categories", null, new { @class = "btn btn-outline-secondary" })
}
