
@model Admin_doan.Models.categories
//đường dẫn model cần cho chức năng, chỉ cần thay phần "Admin_doan" theo tên cấu trúc.

@{
    ViewBag.Title = "Sửa danh mục";
}

<div class="container mt-4">
    <h2>Sửa danh mục</h2>

    @using (Html.BeginForm("CategoryEdit", "Category", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.category_id)

        <div class="mb-3">
            <label>Tên danh mục</label>
            @Html.TextBoxFor(m => m.category_name,
                          new { @class = "form-control" })
        </div>

        <div class="mb-3">
            <label>Slug</label>
            @Html.TextBoxFor(m => m.slug,
                          new { @class = "form-control" })
        </div>

        <div class="mb-3">
            <label>Mô tả</label>
            @Html.TextAreaFor(m => m.description,
                          new { @class = "form-control", rows = "3" })
        </div>

        <div class="mb-3">
            <label>Thứ tự hiển thị</label>
            @Html.TextBoxFor(m => m.display_order,
                          new { @class = "form-control", type = "number" })
        </div>

        <button type="submit" class="btn btn-primary">Cập nhật</button>

        @Html.ActionLink("Quay lại", "Categories", null,
                      new { @class = "btn btn-secondary" })
    }
</div>
