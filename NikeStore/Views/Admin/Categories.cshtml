
@model IEnumerable<NikeStore.Models.category>
@{
    ViewBag.Title = "Quản lý danh mục";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Quản lý danh mục</h2>

        @Html.ActionLink("Thêm danh mục", "CategoryCreate", "Category",
                      null, new { @class = "btn btn-success" })
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tên danh mục</th>
                <th>Slug</th>
                <th>Thứ tự</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.category_id</td>
                    <td>@item.category_name</td>
                    <td>@item.slug</td>
                    <td>@item.display_order</td>
                    <td>@(item.is_active == true ? "Hoạt động" : "Ngừng")</td>
                    <td>
                        @Html.ActionLink("Sửa", "CategoryEdit",
                                      new { id = item.category_id },
                                      new { @class = "btn btn-warning btn-sm" })

                        @if (item.is_active == true)
                        {
                            using (Html.BeginForm("Deactivate", "Category",
                                new { id = item.category_id }, FormMethod.Post,
                                new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm"
                                        onclick="return confirm('Ngừng danh mục này?')">
                                    Ngừng
                                </button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
